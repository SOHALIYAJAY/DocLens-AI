{
  "manifest_version": 3,
  "name": "AI PDF Assistant",
  "version": "1.0.0",
  "description": "Read, summarize, and chat with PDF documents using AI directly in your browser.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "assets/icons/icons16.jpg",
    "32": "assets/icons/icons32.jpg",
    "48": "assets/icons/icons48.jpg",
    "128": "assets/icons/icons128.jpg"
  },
  "action": {
    "default_title": "AI PDF Assistant",
    "default_icon": {
      "16": "assets/icons/icons16.jpg",
      "32": "assets/icons/icons32.jpg",
      "48": "assets/icons/icons48.jpg",
      "128": "assets/icons/icons128.jpg"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "file:///*",
    "*://*/*.pdf",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/pdf.worker.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
