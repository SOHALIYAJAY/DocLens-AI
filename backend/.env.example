# ==============================================================================
# DocLens-AI — Example Environment Configuration
# Copy this file to .env and insert your API keys. NEVER commit .env to git!
# ==============================================================================

# Groq API Keys (Fast LLM Chat & Hybrid RAG)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini
GROQ_VISION_API_KEY=your_groq_vision_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Google Gemini Vision API (Multimodal Image & Architecture Analysis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_VISION_MODEL=gemini-3-flash-preview

# AgentRouter / Anthropic Claude (Optional)
AGENTROUTER_API_KEY=your_agentrouter_api_key_here
AGENTROUTER_BASE_URL=https://agentrouter.org/
CLAUDE_MODEL=claude-3-5-sonnet-20241022
